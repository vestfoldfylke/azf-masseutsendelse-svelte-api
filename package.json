{
	"name": "azf-masseutsendelse-svelte-api",
	"version": "0.0.1",
	"description": "Api for masseutsendelse svelte web",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf dist",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"prestart": "npm run clean && npm run build",
		"start": "func start",
		"test": "npm run lint && node --import tsx --test --require ./src/sharedcode/tests/setEnvVars.ts \"src/sharedcode/tests/**/*.test.ts\""
	},
	"engines": {
		"node": ">=18"
	},
	"main": "dist/src/functions/*.js",
	"dependencies": {
		"@azure/functions": "^4.16.2",
		"@azure/identity": "^4.13.1",
		"@azure/storage-blob": "^12.33.0",
		"@vestfoldfylke/loglady": "^2.1.0",
		"@vtfk/azure-blob-client": "^0.2.0",
		"dayjs": "^1.11.21",
		"mongoose": "^9.8.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "^22.0.0",
		"mongodb-memory-server": "^11.2.0",
		"msw": "^1.3.2",
		"tsx": "^4.19.0",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"cookie": "^0.7.0"
	},
	"config": {
		"mongodbMemoryServer": {
			"version": "7.0.24"
		}
	}
}
