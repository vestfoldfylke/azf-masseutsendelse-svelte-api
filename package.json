{
	"name": "azf-masseutsendelse-svelte-api",
	"version": "1.0.0",
	"description": "Api for masseutsendelse svelte web",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf dist",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"prestart": "npm run clean && npm run build",
		"start": "func start",
		"test": "npm run lint && node --import tsx --test --require ./src/sharedcode/tests/setEnvVars.ts \"src/sharedcode/tests/**/*.test.ts\""
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"main": "dist/src/functions/*.js",
	"dependencies": {
		"@azure/functions": "^4.17.0",
		"@azure/identity": "^4.14.1",
		"@azure/storage-blob": "^12.34.0",
		"@vestfoldfylke/azure-blob-client": "^2.0.0",
		"@vestfoldfylke/loglady": "^2.1.0",
		"dayjs": "^1.11.23",
		"mongoose": "^9.11.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/node": "^26.6.5",
		"mongodb-memory-server": "^11.3.0",
		"msw": "^3.0.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3"
	},
	"config": {
		"mongodbMemoryServer": {
			"version": "7.0.24"
		}
	}
}
